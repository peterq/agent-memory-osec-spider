{
  "permissions": {
    "allow": [
      "Bash(go run ./tools/*)",
      "Bash(ssh -N -L *)",
      "Bash(./deploy.sh *)",
      "Bash(./scripts/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/mem/mem.py boot 2>/dev/null"
          }
        ]
      }
    ]
  }
}
